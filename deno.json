{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@vhespanha/ssx",
  "version": "0.2.0",
  "exports": {
    ".": "./mod.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-runtime.ts"
  },
  "license": "MIT",
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "ssx": "./mod.ts",
    "ssx/jsx-runtime": "./jsx-runtime.ts"
  },
  "lock": false,
  "tasks": {
    "test": "deno test -R",
    "bench": "deno bench --allow-env benchmark/bench.ts",
    "build-types": "deno task build-types:html & deno task build-types:css",
    "build-types:html": "deno run -A _scripts/types_html.ts && deno fmt html.ts",
    "build-types:css": "deno run -A _scripts/types_css.ts && deno fmt css.ts",
    "build-npm": "deno run -A _scripts/build_npm.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ssx"
  },
  "lint": {
    "rules": {
      "tags": ["jsr", "jsx", "recommended"]
    }
  },
  "exclude": [
    "CHANGELOG.md",
    "tests/expected.html"
  ],
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "css.ts",
      "html.ts",
      "jsx-runtime.ts",
      "mod.ts",
      "deno.json"
    ]
  }
}
